# =====================================================================
# TB backend — DigitalOcean Droplet uchun muhit oʻzgaruvchilari
#
# Droplet ichida shu faylni `.env.production` nomi bilan nusxalang va
# qiymatlarni toʻldiring. Bu fayl git'ga TUSHMAYDI (.gitignore).
#
#   cp .env.production.example .env.production
#   nano .env.production
# =====================================================================

# --- Domen -----------------------------------------------------------
# Caddy shu domen uchun sertifikat oladi. Domen droplet IP'siga
# A-yozuv bilan yoʻnaltirilgan boʻlishi shart.
# Domen yoʻq boʻlsa: <IP>.sslip.io yozing (masalan 157.245.10.20.sslip.io)
TB_API_DOMAIN=api.example.uz

# --- Django ----------------------------------------------------------
# Yaratish:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Alohida boʻlgani maʼqul (boʻsh boʻlsa SECRET_KEY ishlatiladi)
JWT_SECRET=

# TB_API_DOMAIN bilan bir xil domen + healthcheck uchun 127.0.0.1
DJANGO_ALLOWED_HOSTS=api.example.uz,127.0.0.1,localhost

# Django admin paneliga kirish uchun (POST forma CSRF tekshiruvi)
CSRF_TRUSTED_ORIGINS=https://api.example.uz

# Vercel'dagi frontend domeni. Soʻrovlar Vercel rewrite orqali server
# tomondan ketgani uchun odatda kerak emas, lekin brauzerdan toʻgʻridan-
# toʻgʻri chaqirish ehtimoliga qarshi yozib qoʻyilgani maʼqul.
CORS_ALLOWED_ORIGINS=https://fronted-depo-tb.vercel.app

# --- Baza ------------------------------------------------------------
POSTGRES_DB=tb
POSTGRES_USER=tb
# Yaratish:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Depo ------------------------------------------------------------
NEXT_PUBLIC_DEPO_KOD=TCH-6
# Administrator tabel raqami. PIN ATAYLAB berilmaydi — administrator
# birinchi kirishda oʻzi oʻrnatadi.
TB_ADMIN_TABEL=0212

# Boshlangʻich maʼlumot va kadrlar roʻyxati (birinchi koʻtarilishda 1).
# Baza toʻlgach 0 qilsangiz konteyner tezroq koʻtariladi.
TB_SEED=1
TB_XODIMLAR=1

# --- Ishlash ---------------------------------------------------------
# Har bir gunicorn worker ~120 MB RAM yeydi.
#   1 GB droplet → 1   (60 foydalanuvchiga yetadi: 1 worker × 4 thread)
#   2 GB droplet → 2
#   4 GB droplet → 3–4
WEB_CONCURRENCY=1
TZ=Asia/Tashkent
LOG_LEVEL=INFO

# --- FaceID (ixtiyoriy, RAM 8 GB+ kerak) -----------------------------
# Boʻsh qolsa yuz tanish OʻCHIQ — tizim faqat PIN bilan ishlaydi.
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
FACE_THRESHOLD=0.62
