# =====================================================================
# TB tizimi — Django backend muhit oʻzgaruvchilari
#
# LOKAL ishlab chiqish uchun: shu faylni `.env` nomi bilan nusxalang.
# PRODUCTIONDA: qiymatlar docker-compose orqali .env.production dan
# beriladi, bu fayl serverga koʻchirilmaydi.
# =====================================================================

# --- Asosiy ---
DJANGO_DEBUG=1

# Productionda MAJBURIY. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# JWT imzo kaliti (boʻsh boʻlsa DJANGO_SECRET_KEY ishlatiladi).
# Alohida boʻlgani maʼqul — shunda sessiya kaliti bilan aralashmaydi.
JWT_SECRET=
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=30

# Vergul bilan ajratilgan. Productionda aniq domenni yozing.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Maʼlumotlar bazasi ---
# Variant 1: toʻliq URL (docker-compose shuni beradi)
DATABASE_URL=postgres://tb:PAROL@127.0.0.1:5432/tb

# Variant 2: alohida (DATABASE_URL boʻsh boʻlsa ishlatiladi)
# POSTGRES_DB=tb
# POSTGRES_USER=tb
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Postgres yoʻq boʻlsa lokal sinov uchun:
# DATABASE_URL=sqlite://dev.sqlite3

# --- CORS ---
# Next.js boshqa portda ishlayotganda kerak.
# Bitta domendan (Caddy orqali) ishlatilsa — boʻsh qoldiring.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# --- Depo ---
NEXT_PUBLIC_DEPO_KOD=TCH-6

# --- Cheklovlar (800 foydalanuvchi uchun himoya) ---
THROTTLE_LOGIN=20/min
THROTTLE_WRITE=240/min
DATA_UPLOAD_MAX_MB=25

# --- FaceID xizmati (ixtiyoriy) ---
# URL boʻsh boʻlsa yuz tanish OʻCHIQ — tizim faqat PIN bilan ishlaydi.
# Yoqish (RAM 8 GB+ kerak):
#   docker compose --env-file .env.production --profile face up -d --build
#   FACE_SERVICE_URL=http://face:8000
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
# Moslik chegarasi 0..1 — baland qiymat qatʼiyroq (0.62 tavsiya etiladi)
FACE_THRESHOLD=0.62
# Servis javobini shuncha soniya kutamiz
FACE_TIMEOUT=12
# Kirish/roʻyxatdan oʻtishda nechta kadr olinadi (jonlilik uchun ≥2)
FACE_FRAMES=3

# --- Boshqa ---
TZ=Asia/Tashkent
LOG_LEVEL=INFO
